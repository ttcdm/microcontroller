cached bit 9 to the\nactual bit 9\nthis only thing i had to google",14]}},{"x":3780,"y":-950,"objectType":"Text","label":"EQUALS","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["EQUALS",14]}},{"x":3850,"y":-950,"objectType":"Text","label":"INC","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["INC",14]}},{"x":3840,"y":-840,"objectType":"Text","label":"RESET","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RESET",14]}},{"x":3630,"y":-2660,"objectType":"Text","label":"8 bit stream","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["8 bit stream",14]}},{"x":3760,"y":-2730,"objectType":"Text","label":"16 bit stream","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["16 bit stream",14]}},{"x":4140,"y":-2660,"objectType":"Text","label":"8 bit stream","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["8 bit stream",14]}},{"x":4280,"y":-2740,"objectType":"Text","label":"16 bit stream","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["16 bit stream",14]}},{"x":4720,"y":-1780,"objectType":"Text","label":"READ SW","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["READ SW",14]}},{"x":6020,"y":-1850,"objectType":"Text","label":"BIT 1","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["BIT 1",14]}},{"x":4800,"y":-1380,"objectType":"Text","label":"it's red because the tri state flip flop doesn't output\na low signal when it isn't enabled unlike transistors,\nwhich is what i'm using it in place of","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["it's red because the tri state flip flop doesn't output\na low signal when it isn't enabled unlike transistors,\nwhich is what i'm using it in place of",14]}},{"x":3650,"y":-1900,"objectType":"Text","label":"write to\nmain","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["write to\nmain",14]}},{"x":3120,"y":-1920,"objectType":"Text","label":"multiplicand","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["multiplicand",14]}},{"x":3290,"y":-1720,"objectType":"Text","label":"main bus","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["main bus",14]}},{"x":3120,"y":-2000,"objectType":"Text","label":"product","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["product",14]}},{"x":3180,"y":-2010,"objectType":"Text","label":"difference/\nquotient","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["difference/\nquotient",14]}},{"x":3160,"y":-1910,"objectType":"Text","label":"subtrahend","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["subtrahend",14]}},{"x":3070,"y":-1990,"objectType":"Text","label":"READ","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["READ",14]}},{"x":3070,"y":-1910,"objectType":"Text","label":"WRITE","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["WRITE",14]}},{"x":3290,"y":-1910,"objectType":"Text","label":"dividend","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["dividend",14]}},{"x":3230,"y":-1920,"objectType":"Text","label":"multiplier","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["multiplier",14]}},{"x":3600,"y":-1890,"objectType":"Text","label":"0-ADD\n1-SUB","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["0-ADD\n1-SUB",14]}},{"x":3040,"y":370,"objectType":"Text","label":"There's a race condition issue\nwhere when the clock signal\nis stopped by the comparison\nswitch propagates down the line\ntowards the incremement after\nthe reset signal is pushed to the\nregisters because the cut off\nis 2 components away from the\nincrement and the reset signal is\nonly one component away so\nwhen the clock signal is cut off,\nthe stream's still flowing i think\ncausing the reset to only break\noff the front of it\nand still have the remainder\nflow through an increment again.\none way to solve this is to have\nan xor gate and two nots branch\noff of the clock signal to cause a\nquick pulse that can fit between\nthe timings or slow down the\nreset multiplexer switch thing\nthat's to the top left of the\nregisters","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["There's a race condition issue\nwhere when the clock signal\nis stopped by the comparison\nswitch propagates down the line\ntowards the incremement after\nthe reset signal is pushed to the\nregisters because the cut off\nis 2 components away from the\nincrement and the reset signal is\nonly one component away so\nwhen the clock signal is cut off,\nthe stream's still flowing i think\ncausing the reset to only break\noff the front of it\nand still have the remainder\nflow through an increment again.\none way to solve this is to have\nan xor gate and two nots branch\noff of the clock signal to cause a\nquick pulse that can fit between\nthe timings or slow down the\nreset multiplexer switch thing\nthat's to the top left of the\nregisters",14]}}],"restrictedCircuitElementsUsed":[],"nodes":[29,30,31,32,35,36,37,40,41,42,66,67,68,77,78,79,80,81,91,92,93,94,95,96,97,98,99,100,101,102,1